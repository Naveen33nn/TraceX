# Blockchain data providers
BLOCKCHAIN_COM_API_KEY=""
ETHERSCAN_API_KEY=""
ALCHEMY_API_KEY=""
ALCHEMY_ETHEREUM_URL=""
ALCHEMY_POLYGON_URL=""
INFURA_PROJECT_ID=""
INFURA_ETHEREUM_URL=""
INFURA_POLYGON_URL=""
BITQUERY_ACCESS_TOKEN=""

# VASP/entity enrichment providers
METASLEUTH_API_KEY=""
METASLEUTH_BASE_URL="https://aml.blocksec.com"
WALLETEXPLORER_BASE_URL="https://www.walletexplorer.com/api/1"
VASP_PROVIDERS="metasleuth,walletexplorer,etherscan"

# TRON data only. This key is never used for VASP attribution.
TRON_DATA_BASE_URL="https://api.trongrid.io"
TRON_API_KEY=""

# Local Neo4j graph database
NEO4J_ENABLED="true"
NEO4J_URI="bolt://127.0.0.1:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
NEO4J_MAX_NODES="10000"
NEO4J_MAX_RELATIONSHIPS="25000"
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Collection and storage limits
STORAGE_DIR="storage"
DATA_DIR="storage"
HTTP_TIMEOUT_SECONDS="30"
PAGE_SIZE="100"
MAX_PAGES="100"
MAX_RECORDS="5000"
INCLUDE_RAW="true"
ALCHEMY_VERIFY_TRANSACTIONS="true"
ALCHEMY_INCLUDE_TOKEN_BALANCES="true"
VASP_LABEL_TTL_SECONDS="86400"
